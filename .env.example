# Copia este archivo a .env y rellena los valores
# .env NUNCA se sube a Git

# Base de datos. Python local: dejar comentado para usar SQLite (dev.db).
# Docker/Producción: postgresql://user:pass@host/db?sslmode=require
# DATABASE_URL=

# Clave de sesiones. En local cualquier cosa larga sirve; en Render se autogenera.
SECRET_KEY=cambia-esto-por-algo-aleatorio-y-largo

# Si False, solo el admin puede crear cuentas (registro público bloqueado)
PERMITIR_REGISTRO_PUBLICO=true

# Si True, permite "importar desde ruta local del PC" — útil solo en localhost.
# En producción déjalo en false (sin acceso al filesystem del servidor).
PERMITIR_RUTA_LOCAL=true

# Docker Compose
# APP_PORT=5050
# HOST_XMLS_DIR=/Users/tuusuario/ruta/a/xmls
